# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของเครื่องตัวเอง (.env ไม่ถูก commit ขึ้น git)
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=your_db_password
DB_DATABASE=mini_project_db

PORT=3000

# สร้างค่าใหม่เอง เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_random_secret
JWT_REFRESH_EXPIRES_IN=7d
